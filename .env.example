# Хеш пароля админки: pnpm hash-password
ADMIN_PASSWORD_HASH=''

# Сайт работает за обратным прокси (Traefik из Dokploy). Из этих заголовков adapter-node берёт
# протокол, хост и IP клиента: протокол и хост нужны для проверки origin у форм (CSRF),
# IP — для ограничения попыток входа. Наружу порт не публикуется, в контейнер ходит только прокси.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
